{
  "name": "liminal-field-git",
  "version": "0.1.0",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./errors": {
      "types": "./errors.d.ts",
      "default": "./errors.js"
    }
  },
  "napi": {
    "binaryName": "liminal-field-git",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:errors": "tsc errors.ts --declaration --module commonjs --target es2020 --moduleResolution node --esModuleInterop",
    "test": "npm run build:errors && cargo test --lib --no-default-features && jest",
    "test:rust": "cargo test --lib --no-default-features",
    "test:js": "npm run build:errors && jest",
    "test:unit": "cargo test --lib --features test-utils",
    "test:integration": "cargo test --test '*' --features test-utils",
    "prepublishOnly": "npm run build:errors && napi prepublish -t npm",
    "artifacts": "napi artifacts",
    "version": "napi version"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@napi-rs/cli": "^3.2.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}