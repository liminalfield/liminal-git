{
  "name": "liminal-git",
  "version": "0.1.0",
  "description": "Native git operations for Node.js, built on libgit2 via napi-rs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liminalfield/liminal-git.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "napi": {
    "binaryName": "liminal-git",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "//prepare": "Runs on `npm install` from a git URL, which is how Nocturne consumes this. The compiled addon is not committed, so without this a git install yields source and no binding. Requires a Rust toolchain and a C compiler on the installing machine — a deliberate choice: consumers build from source rather than being shipped binaries.",
    "prepare": "napi build --platform --release",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "cargo test --lib --no-default-features",
    "test:rust": "cargo test --lib --no-default-features",
    "test:unit": "cargo test --lib --features test-utils",
    "test:integration": "cargo test --test '*' --features test-utils",
    "prepublishOnly": "napi prepublish -t npm",
    "artifacts": "napi artifacts",
    "version": "napi version"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@napi-rs/cli": "^3.2.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
