# Rust build output
/target/

# napi build output — the compiled addon is built on install, never committed.
# See the `prepare` script in package.json.
*.node

# Node
node_modules/

# Real git repositories built at test time by tests/fixtures/create_repos.rs,
# written to the working directory rather than a temp dir. They are build
# output — and being git repos themselves, committing them would nest a
# repository inside this one.
/test-fixtures/

# OS
.DS_Store

# npm pack output (the CI packed-install check creates this)
*.tgz
